# Copied to .env by `make setup` if .env is missing. .env is gitignored.
# DB and OpenEMR values are for a local, synthetic-data-only container. Change them if you like.

COMPOSE_PROJECT_NAME=beacon

# Host ports for OpenEMR (login page: http://localhost:${OPENEMR_HTTP_PORT})
OPENEMR_HTTP_PORT=8300
OPENEMR_HTTPS_PORT=9300

# MariaDB root password, and the DB user OpenEMR creates for itself
MYSQL_ROOT_PASSWORD=root-local-only
MYSQL_USER=openemr
MYSQL_PASS=openemr-local-only

# OpenEMR admin login created on first boot
OE_USER=admin
OE_PASS=pass

# Needed from build step 7 (heal agent). Paste your own key; never commit it.
ANTHROPIC_API_KEY=
